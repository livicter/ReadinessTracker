// Local Fitbit OAuth credentials — copy to Secrets.xcconfig (gitignored) and fill in.
// Do NOT commit Secrets.xcconfig or real client secrets.
//
// Optional Xcode wiring:
//   1. Copy this file to Secrets.xcconfig in the repo root.
//   2. In Xcode → ReadinessTracker target → Build Settings → add user-defined
//      FITBIT_CLIENT_ID / FITBIT_CLIENT_SECRET, OR set the target's based-on
//      configuration file to Secrets.xcconfig (Debug & Release).
//   3. Info.plist already maps $(FITBIT_CLIENT_ID) / $(FITBIT_CLIENT_SECRET).
//   4. Clean + rebuild so Bundle.main picks up the values.
//
// Empty defaults keep CI / fresh clones building without secrets.

FITBIT_CLIENT_ID =
FITBIT_CLIENT_SECRET =
